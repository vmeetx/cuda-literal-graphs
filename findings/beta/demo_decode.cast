[6.36238, "o", "\ufffd\ufffd\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m                   \u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u001b[0m\u001b[38;2;22;110;120m\u2588\u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m\u001b[38;2;36;36;46m\u001b[48;2;57;197;187m\u2580\u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;36;36;46m\u2580\u001b[0m\u001b[38;2;255;222;204m\u001b[48;2;57;197;187m\u2580\u001b[0m\u001b[38;2;255;222;204m\u2588\u2588\u001b[0m\u001b[38;2;22;110;120m\u001b[48;2;255;222;204m\u2580\u001b[0m\u001b[38;2;255;222;204m\u2588\u001b[0m\u001b[38;2;255;222;204m\u001b[48;2;22;110;120m\u2580\u001b[0m\u001b[38;2;255;222;204m\u2588\u2588\u001b[0m\u001b[38;2;22;110;120m\u001b[48;2;255;222;204m\u2580\u001b[0m\u001b[38;2;255;222;204m\u2588\u2588\u001b[0m\u001b[38;2;255;222;204m\u001b[48;2;57;197;187m\u2580\u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u2588\u001b[0m\u001b[38;2;22;110;120m\u2588\u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m\u001b[38;2;112;196;72m\u2588\u2588\u001b[0m   \u001b[13;1H        \u001b[0m\u001b[38;2;210;214;222m\u25bc\u001b[0m                     \u001b[0m\u001b[38;2;210;214;222m\u25bc\u001b[0m                     \u001b[0m\u001b[38;2;210;214;222m\u25bc\u001b[0m                   \u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u001b[0m\u001b[38;2;22;110;120m\u001b[48;2;57;197;187m\u2580\u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u2588\u001b[0m\u001b[38;2;36;36;46m\u2580\u001b[0m\u001b[38;2;57;197;187m\u2580\u001b[0m\u001b[38;2;255;222;204m\u2580\u2588\u2588\u2588\u2588\u2588\u2588\u2580\u001b[0m\u001b[38;2;57;197;187m\u2580\u001b[0m \u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u2588\u2588\u001b[0m\u001b[38;2;240;242;232m\u2588\u001b[0m\u001b[38;2;240;242;232m\u001b[48;2;57;197;187m\u2580\u001b[0m    \u001b[14;1H     \u001b