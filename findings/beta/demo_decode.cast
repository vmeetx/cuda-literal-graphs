[6.362237, "o", "\u001b[0m\u001b[2J\u001b[1;1H\u001b[0m                                                                                                    \u001b[2;1H                                \u001b[0m\u001b[38;2;57;197;187m\u2584\u2584\u2588\u2588\u2588\u2588\u2584\u2584\u001b[0m                                                            \u001b[3;1H                               \u001b[0m\u001b[38;2;36;36;46m\u2588\u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[38;2;36;36;46m\u2588\u001b[0m                                                           \u001b[4;1H                               \u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u001b[0m\u001b[38;2;255;222;204m\u2588\u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;22;110;120m\u2580\u001b[0m\u001b[38;2;255;222;204m\u2588\u2588\u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;22;110;120m\u2580\u001b[0m\u001b[38;2;255;222;204m\u2588\u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u001b[0m                                                           \u001b[5;1H                              \u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;22;110;120m\u2580\u001b[0m \u001b[0m\u001b[38;2;36;36;46m\u2584\u001b[0m\u001b[38;2;255;222;204m\u001b[48;2;196;202;208m\u2580\u001b[0m\u001b[38;2;255;222;204m\u001b[48;2;57;197;187m\u2580\u2580\u001b[0m\u001b[38;2;255;222;204m\u001b[48;2;196;202;208m\u2580\u001b[0m\u001b[38;2;36;36;46m\u2584\u001b[0m \u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;22;110;120m\u2580\u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m                                       \u001b[0m\u001b[38;2;57;197;187m\u2584\u2584\u2584\u2584\u2584\u2584\u001b[0m             \u001b[6;1H                              \u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m\u001b[38;2;22;110;120m\u2588\u001b[0m \u001b[0m\u001b[38;2;36;36;46m\u001b[48;2;255;222;204m\u2580\u001b[0m\u001b[38;2;196;202;208m\u2588\u2588\u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m\u001b[38;2;196;202;208m\u2588\u001b[0m\u001b[38;2;36;36;46m\u001b[48;2;255;222;204m\u2580\u001b[0m \u001b[0m\u001b[38;2;22;110;120m\u2588\u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m                                    \u001b[0m\u001b[38;2;57;197;187m\u2584\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2584\u001b[0m          \u001b[7;1H                              \u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m\u001b[38;2;22;110;120m\u2588\u001b[0m\u001b[38;2;36;36;46m\u2584\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[38;2;240;242;232m\u2588\u001b[0m \u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m                                   \u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2584\u001b[0m        \u001b[8;1H                         \u001b[0m\u001b[1m\u001b[38;2;255;244;170m\u001b[48;2;110;84;10m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\u001b[38;2;57;197;187m\u2580\u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;255;222;204m\u2580\u2580\u001b[0m\u001b[38;2;112;196;72m\u2580\u001b[0m                                   \u001b[0m\u001b[38;2;57;197;187m\u2584\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2584\u001b[0m    \u001b[0m\u001b[38;2;112;196;72m\u2584\u001b[0m  \u001b[9;1H                         \u001b[0m\u001b[1m\u001b[38;2;255;244;170m\u001b[48;2;110;84;10m\u2502\u001b[0m\u001b[38;2;150;190;196m \u001b[0m\u001b[38;2;225;228;232mnorm x8\u001b[0m\u001b[38;2;150;190;196m \u001b[0m\u001b[1m\u001b[38;2;255;244;170m\u001b[48;2;110;84;10m\u2502\u001b[0m \u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;36;36;46m\u2580\u2580\u001b[0m                                  \u001b[0m\u001b[38;2;57;197;187m\u2584\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;255;222;204m\u2580\u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;255;222;204m\u2