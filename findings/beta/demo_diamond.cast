[9.211877, "o", "\u2588\u001b[0m\u001b[38;2;112;196;72m\u2588\u2588\u001b[0m   \u001b[13;1H   \u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m\u001b[38;2;22;110;120m\u2588\u001b[0m \u001b[0m\u001b[38;2;36;36;46m\u2588\u001b[0m\u001b[38;2;196;202;208m\u2588\u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;196;202;208m\u2580\u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m\u001b[38;2;196;202;208m\u2588\u001b[0m\u001b[38;2;36;36;46m\u2588\u001b[0m \u001b[0m\u001b[38;2;22;110;120m\u2588\u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m           \u001b[0m\u001b[38;2;112;116;128m\u2502\u001b[0m \u001b[0m\u001b[38;2;150;190;196m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m              \u001b[0m\u001b[38;2;112;116;128m\u2502\u001b[0m                    \u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u001b[0m\u001b[38;2;22;110;120m\u001b[48;2;57;197;187m\u2580\u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u2588\u001b[0m\u001b[38;2;36;36;46m\u2580\u001b[0m\u001b[38;2;57;197;187m\u2580\u001b[0m\u001b[38;2;255;222;204m\u2580\u2588\u2588\u2588\u2588\u2588\u2588\u2580\u001b[0m\u001b[38;2;57;197;187m\u2580\u001b[0m \u001b[0m\u001b[38;2;57;197;187m\u2588\u2588\u2588\u2588\u001b[0m\u001b[38;2;240;242;232m\u2588\u001b[0m\u001b[38;2;240;242;232m\u001b[48;2;57;197;187m\u2580\u001b[0m    \u001b[14;1H   \u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m\u001b[38;2;22;110;120m\u2588\u001b[0m \u001b[0m\u001b[38;2;255;222;204m\u001b[48;2;36;36;46m\u2580\u001b[0m\u001b[38;2;196;202;208m\u001b[48;2;36;36;46m\u2580\u2580\u001b[0m\u001b[38;2;57;197;187m\u001b[48;2;36;36;46m\u2580\u001b[0m\u001b[38;2;196;202;208m\u001b[48;2;36;36;46m\u2580\u001b[0m\u001b[38;2;255;222;204m\u001b[48;2;36;36;46m\u2580\u001b[0m\u001b[38;2;240;242;232m\u2584\u001b[0m\u001b[38;2;22;110;120m\u2580\u001b[0m\u001b[38;2;57;197;187m\u2588\u001b[0m           \u001b[0m\u001b[38;2;112;116;128m\u2502\u001b[0m                        \u001b[0m\u001b[38;2;112;116;128m\u2502\u001b[0m                   \u001b[0m\u001b[38;2;57;197;1